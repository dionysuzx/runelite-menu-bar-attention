#!/bin/zsh
set -euo pipefail

project_directory=${0:A:h:h}
runelite_app=/Applications/RuneLite.app
install_directory=${RUNELITE_ATTENTION_INSTALL_DIRECTORY:-$HOME/Applications}
app_name='RuneLite Attention.app'
app_directory=$install_directory/$app_name
jar_path=$project_directory/build/libs/runelite-menu-bar-attention-0.1.0-all.jar

if [[ ! -d $runelite_app ]]; then
	print -u2 'RuneLite must be installed in /Applications first.'
	exit 1
fi

jdk_home=${JAVA_HOME:-$(/usr/libexec/java_home -v 17 2>/dev/null || true)}
if [[ -z $jdk_home || ! -x $jdk_home/bin/javac || ! -x $jdk_home/bin/jpackage ]]; then
	print -u2 'JDK 17 is required. Install Temurin 17, then rerun just install.'
	exit 1
fi

JAVA_HOME=$jdk_home $project_directory/gradlew clean test shadowJar --no-daemon

staging_directory=$(/usr/bin/mktemp -d /tmp/runelite-attention.XXXXXX)
trap '/bin/rm -rf -- "$staging_directory"' EXIT
staged_app=$staging_directory/$app_name

/bin/mkdir -p $install_directory
$jdk_home/bin/jpackage \
	--type app-image \
	--dest $staging_directory \
	--name 'RuneLite Attention' \
	--app-version 1.0.0 \
	--vendor dionysuzx \
	--description 'RuneLite with persistent macOS menu-bar attention' \
	--copyright 'Copyright 2026 dionysuzx' \
	--mac-package-identifier com.dionysuzx.runelite-menu-bar-attention \
	--mac-app-category games \
	--icon $runelite_app/Contents/Resources/icons.icns \
	--input $project_directory/build/libs \
	--main-jar ${jar_path:t} \
	--main-class com.menubarattention.MenuBarAttentionPluginTest \
	--runtime-image $runelite_app/Contents/Resources/jre \
	--java-options '-ea' \
	--java-options '-Xmx768m' \
	--java-options '-Xss2m' \
	--java-options '-XX:CompileThreshold=1500' \
	--java-options '-Dapple.awt.application.appearance=system' \
	--java-options '-Dapple.awt.application.name=RuneLite Attention' \
	--java-options '--add-opens=java.base/java.lang.reflect=ALL-UNNAMED' \
	--java-options '--add-opens=java.desktop/com.apple.eawt=ALL-UNNAMED' \
	--java-options '--add-opens=java.desktop/sun.awt=ALL-UNNAMED' \
	--arguments '--developer-mode' \
	--arguments '--debug'

/usr/bin/codesign --verify --deep --strict $staged_app
if [[ -e $app_directory ]]; then
	/bin/rm -rf -- $app_directory
fi
/usr/bin/ditto $staged_app $app_directory
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f $app_directory

print "Installed $app_directory"
